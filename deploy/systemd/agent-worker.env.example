# Supabase direct connection, or shared session pooler (port 5432). For the
# shared pooler the username is scholarflow_agent_worker.PROJECT_REF.
DATABASE_URL=postgresql://scholarflow_agent_worker.PROJECT_REF:replace-me@pooler-host:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
AI_MODEL_WRITER=qwen3:8b
AI_MODEL_RESEARCHER=qwen3:8b
AI_MODEL_REVIEWER=qwen3:8b
AI_REQUEST_TIMEOUT_MS=600000
# Optional fallback when Ollama is unreachable or times out: any OpenAI-compatible
# API, e.g. FreeLLMAPI (base URL includes /v1). Course text and drafts are sent to
# this provider and the cloud models behind it. Leave the base URL empty to disable.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_TIMEOUT_MS=120000
AI_NUM_CTX=16384
AI_NUM_PREDICT=4096
AI_TOP_P=0.9
AGENT_JOB_LEASE_MS=120000
AGENT_WORKER_HEARTBEAT_MS=30000
AGENT_WORKER_POLL_MS=2000
