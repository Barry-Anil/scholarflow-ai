# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for authentication and persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
SUPABASE_STORAGE_BUCKET=course-materials

# AI (optional; the workspace remains explorable without these values)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Optional role-specific overrides; otherwise OLLAMA_MODEL is used.
# AI_MODEL_WRITER=qwen3:8b
# AI_MODEL_RESEARCHER=qwen3:8b
# AI_MODEL_REVIEWER=qwen3:8b
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_MS=120000
# Optional fallback when Ollama is unreachable or times out: any OpenAI-compatible
# API, e.g. FreeLLMAPI (base URL includes /v1). Course text and drafts are sent to
# this provider and the cloud models behind it. Leave the base URL empty to disable.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_TIMEOUT_MS=120000
# Optional structured-generation controls. Tune these on the Ubuntu worker.
# AI_NUM_CTX=16384
# AI_NUM_PREDICT=4096
# AI_TOP_P=0.9
# AI_SEED=42
# Optional Cloudflare Access service token for a protected remote Ollama server.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional Crossref polite-pool identification. No API key is required.
CROSSREF_CONTACT_EMAIL=
ALLOW_PAID_AI=false

# Safety and budget defaults
MAX_DOCUMENT_SIZE_MB=25
MAX_AGENT_ITERATIONS=5
DAILY_AI_REQUEST_LIMIT=100
DEFAULT_ASSIGNMENT_BUDGET_USD=0
# Required for authenticated readiness/operations calls; use 32+ random characters.
JOB_WORKER_SECRET=replace-with-a-long-random-value

# Durable agent worker (server-side only)
AGENT_JOB_LEASE_MS=120000
AGENT_WORKER_HEARTBEAT_MS=30000
AGENT_WORKER_POLL_MS=2000

# Agent monitor drawer (optional; web app). The worker is reported stale after
# AGENT_MONITOR_WORKER_STALE_MS without a heartbeat (default: 3 heartbeats), and
# a model request is flagged as potentially stalled after AI_REQUEST_TIMEOUT_MS
# plus AGENT_MONITOR_MODEL_GRACE_MS without an outcome.
AGENT_MONITOR_HEALTH_TTL_MS=30000
AGENT_MONITOR_MODEL_GRACE_MS=30000
# AGENT_MONITOR_WORKER_STALE_MS=90000

INWORLD_API_KEY=replace_with_inworld_workspace_base64_credential
INWORLD_TTS_MODEL=inworld-tts-2
# INWORLD_TTS_VOICE_ID=Ashley
